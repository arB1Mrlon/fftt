# --- Minecraft ---
MC_HOST=play.fantime.example
MC_PORT=25565
MC_USERNAME=ExchangeBotAccount
MC_AUTH=microsoft
VIEWER_PORT=3007

# --- Экономика ---
SPHERE_PRICE=80000000
SPHERE_ITEM_NAME=sphere_of_erida

# --- Telegram админ-бот (пополнение/управление) ---
ADMIN_BOT_TOKEN=123456:ABC-your-admin-bot-token
# Через запятую — telegram user_id, которым разрешено управлять ботом
ADMIN_WHITELIST=111111111,222222222

# --- Telegram бот пополнения (для клиентов) ---
DEPOSIT_BOT_TOKEN=654321:ABC-your-deposit-bot-token

# --- Общая БД ---
DB_PATH=./data.sqlite

# --- Связь между депозит-ботом и игровым ботом ---
# порт локального HTTP API, который поднимает depositBot.js для команд извне
GAME_BOT_API_PORT=4000
GAME_BOT_API_TOKEN=change_me_to_random_string
